#!/bin/bash
# /usr/local/bin/status
# Talabaning joriy holati va yo'nalishini ixcham ko'rsatadi.

# getcwd xatolarining oldini olish uchun
cd "/home/${SUDO_USER:-$(whoami)}" 2>/dev/null || cd /tmp

if [ "$EUID" -ne 0 ]; then
    exec sudo /usr/local/bin/status "$@"
fi

USERNAME=${SUDO_USER:-$(whoami)}
DB="/var/ctf/ctf.db"

if [[ ! "$USERNAME" =~ ^[a-z0-9_]+$ ]] || [ ! -d "/home/$USERNAME" ]; then
    echo "❌ Xato: Yaroqsiz foydalanuvchi yoki uy katalogi topilmadi."
    exit 1
fi

db_query() {
    sqlite3 -cmd ".timeout 5000" "$DB" "$1"
}

# Monitoring
db_query "UPDATE progress SET last_seen=CURRENT_TIMESTAMP WHERE username='$USERNAME';" 2>/dev/null || true
db_query "UPDATE telegram_users SET last_ssh_seen=CURRENT_TIMESTAMP WHERE ssh_username='$USERNAME';" 2>/dev/null || true
db_query "INSERT INTO ssh_activity (username, action, stage) SELECT '$USERNAME', 'status', current_stage FROM progress WHERE username='$USERNAME';" 2>/dev/null || true

STAGE=$(db_query "SELECT current_stage FROM progress WHERE username='$USERNAME';")

if [ -z "$STAGE" ]; then
    echo "❌ Siz tizim bazasida topilmadingiz. O'qituvchiga murojaat qiling."
    exit 1
fi

TOTAL_PASS=$(db_query "SELECT COUNT(*) FROM attempts WHERE username='$USERNAME' AND result='pass';")
TOTAL_FAIL=$(db_query "SELECT COUNT(*) FROM attempts WHERE username='$USERNAME' AND result='fail';")

echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
printf "║  📊 CTF HOLAT: %-49s ║\n" "$USERNAME"
echo "╠══════════════════════════════════════════════════════════════════╣"

if [ "$STAGE" -gt 10 ]; then
    FLAG=$(db_query "SELECT flag FROM flags WHERE username='$USERNAME';")
    echo "║  🏆 BARCHA 10 TA QUIZ MUVAFFAQIYATLI YAKUNLANDI!                 ║"
    printf "║  ✅ Natija: %-2s ta flag topildi (✗%-2s xato)                       ║\n" "$TOTAL_PASS" "$TOTAL_FAIL"
    echo "╠══════════════════════════════════════════════════════════════════╣"
    echo "║  🚩 Sizning Yakuniy Flagingiz:                                   ║"
    printf "║  %-64s ║\n" "$FLAG"
    echo "╚══════════════════════════════════════════════════════════════════╝"
    echo ""
    exit 0
fi

# Bosqichlar bo'yicha qisqa mavzu va tavsif
case $STAGE in
    1) THEME="ls -la, cd, cat, head, tail"
       DESC="Yashirin papkalar va audit logi tahlili" ;;
    2) THEME="grep, cut, pipes (|)"
       DESC="Yashirin loglardan maxsus kirish tokenini ajratish" ;;
    3) THEME="sort, uniq, pipes (|)"
       DESC="Shovqinli oqimlar orasidan yagona unikal flagni topish" ;;
    4) THEME="diff, comm"
       DESC="Konfiguratsiya zaxiralaridagi maxfiy o'zgarishni topish" ;;
    5) THEME="sed, cut, pipes (|)"
       DESC="5-ustunni cut bilan ajratib, sed bilan flagni tiklash" ;;
    6) THEME="find, chmod, chown"
       DESC="Qulflangan (000) yashirin faylni topish va o'qish" ;;
    7) THEME="git (log, show, diff)"
       DESC="Git tarixidagi o'chirilgan maxfiy commitni tiklash" ;;
    8) THEME="crontab, at"
       DESC="Rejalashtirilgan cron jadvalidan flagni ajratish" ;;
    9) THEME="dpkg, apt"
       DESC="Debian paketini o'rnatmasdan ichini ko'rish va ochish" ;;
   10) THEME="tar, awk, cut (Master)"
       DESC="Kiberhodisa CSV jadvalini tahlil qilib flagni olish" ;;
    *) THEME="Linux"
       DESC="Joriy topshiriq" ;;
esac

DONE=$((STAGE - 1))
REMAIN=$((10 - DONE))
BAR="["
for ((i=0; i<DONE; i++)); do BAR="${BAR}█"; done
for ((i=0; i<REMAIN; i++)); do BAR="${BAR}░"; done
BAR="${BAR}]"
PCT=$((DONE * 10))

printf "║  📍 Bosqich:      quiz%-2s / 10  %-10s %3s%%                    ║\n" "$STAGE" "$BAR" "$PCT"
printf "║  🎯 Mavzu:        %-46s ║\n" "$THEME"
printf "║  📝 Vazifa:       %-46s ║\n" "$DESC"
printf "║  📊 Urinishlar:   ✓%-3s  ✗%-3s                                      ║\n" "$TOTAL_PASS" "$TOTAL_FAIL"
echo "╠══════════════════════════════════════════════════════════════════╣"
echo "║  🚀 TOPSHIRIQNI KO'RISH:                                         ║"
printf "║     cd ~/quiz%-2s                                                  ║\n" "$STAGE"
printf "║     cat README.txt                                               ║\n"
echo "║                                                                  ║"
echo "║  ✅ FLAGNI TEKSHIRISH:                                           ║"
echo "║     check                                                        ║"
echo "║     (yoki: check FLAG{...})                                      ║"

# Agar oldingi topilgan flaglar bo'lsa, ixcham ko'rsatish
SOLVED_COUNT=$(db_query "SELECT COUNT(*) FROM solved_stages WHERE username='$USERNAME';")
if [ "$SOLVED_COUNT" -gt 0 ]; then
    echo "╠══════════════════════════════════════════════════════════════════╣"
    echo "║  🏁 TOP SHIRILGAN FLAGLAR:                                       ║"
    while IFS='|' read -r s_stage s_flag; do
        if [ -n "$s_stage" ]; then
            printf "║   quiz%-2s: %-52s ║\n" "$s_stage" "$s_flag"
        fi
    done < <(sqlite3 -cmd ".timeout 5000" "$DB" "SELECT stage, flag FROM solved_stages WHERE username='$USERNAME' ORDER BY stage ASC;")
fi

echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""
